# --- Robinhood Chain ---
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
EXPECTED_CHAIN_ID=4663

# --- Ölçüm penceresi (Counter/Backfill) ---
BACKFILL_HOURS=48        # Geriye dönük tarama (48 = 2 gün, 168 = 7 gün)
DURATION_HOURS=0         # Canlı bekleme; 0 = sadece backfill
START_BLOCK=             # Belirli bloktan başla (boş = otomatik)
CONFIRMATIONS=2
MAX_BLOCK_RANGE=5000
TRACK_LIQUIDITY=0        # Kapalı (Artık likiditeyi outcomes.py yönetiyor)
POLL_INTERVAL_SEC=15

# --- RPC Throttling ---
RPC_RPS=5
BATCH_SIZE=25
RPC_BACKOFF_BASE=1
MAX_CATCHUP_ERRORS=20

# --- Çıktı Dizinleri ve Loglar ---
DATA_DIR=data
COUNTER_LOG=counter.log
COUNTER_SUMMARY=counter-summary.json
PROGRESS_INTERVAL_SEC=900

# --- Sampler (Aşama C) ---
SAMPLE_RATE=0.03         # %3 örneklem (Workflow ile uyumlu)
SEED=42
SAMPLE_OUT=sampled-pools.jsonl

# --- Collar API (MCP) ---
COLLAR_MCP_URL=https://api.collarguardrail.com/mcp-http/mcp
COLLAR_API_KEY=          # Secret'tan gelecek, buraya yazma
EVAL_OUT=evaluations.jsonl
DELAY_SEC=180            # T+3dk için bekleme süresi
TIMEOUT_SEC=30
REQ_PER_MIN=8            # Dakikada atılacak maksimum istek (Rate limit güvenliği)
CONCURRENCY=1            # Aynı anda çalışacak işlem sayısı (Sıralı geçiş)

# --- Outcomes (Adli Analiz & Rug Tespiti) ---
OUTCOMES_OUT=outcomes.json
OUTCOMES_OUT_JSONL=outcomes.jsonl
LP_WINDOW_SEC=86400      # 24 saatlik analiz penceresi
LP_PULL_THRESHOLD=0.90   # Likidite %90 düşerse Rug
PRICE_CRASH_THRESHOLD=0.95 # Fiyat %95 düşerse Rug (Pump & Dump)

# Robinhood Chain USDG ve diğer karşıt para birimleri (QUOTE ASSETS)
QUOTE_ADDRS=0x5fc5360d0400a0fd4f2af552add042d716f1d168,0x0000000000000000000000000000000000000000

# --- Publish (UI için JSON üretimi) ---
SCORECARD_OUT=scorecard.json
RECENT_OUT=recent.json
RECENT_LIMIT=100
TOP_RISK_FACTORS=10
RULES_VERSION=v0